# Public base path of the deployment. Use "/" for a bucket root,
# or "/benchmarks/" if the app is served from a sub-path.
VITE_BASE=/
# "history" (clean URLs, needs the S3 error-document fallback) or "hash" (works anywhere).
VITE_ROUTER_MODE=history
# Origin of the Affogata API serving GET /api/v1/public/benchmarks.
# Defaults to https://app.affogata.com; point it at http://localhost:3000 to develop
# against a local backend.
VITE_API_BASE_URL=https://app.affogata.com
